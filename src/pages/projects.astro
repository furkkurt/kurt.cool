	{
		id: "llm-eval",
		category: "AI Developer Tooling & Benchmarking",
		period: "2025 – 2026",
		title: "LLM Code Evaluation Workstation",
		subtitle: "Side-by-side multi-LLM code generation benchmark and sandboxed iframe runner",
		stack: ["TypeScript", "Node.js", "Express", "OpenRouter API", "HTML5 Sandbox", "Tailwind CSS"],
