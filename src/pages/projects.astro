	{
		id: "mobile-web",
		category: "High-Performance Web & Cross-Platform Mobile",
		period: "2024 – 2026",
		title: "renazteknik.com (100/100 Lighthouse) & Flutter Mobile Suite",
		subtitle: "Zero-JS static web architecture and real-time multiplayer Flutter applications",
		stack: ["Astro", "Flutter", "Dart", "Riverpod / Bloc", "Firebase", "REST APIs", "Tailwind CSS"],
		bullets: [
			"Delivered renazteknik.com with perfect 100/100 Google Lighthouse scores across Performance, Accessibility, Best Practices, and SEO using Astro islands and WebP asset pipelines.",
			"Engineered cross-platform Flutter apps including Herkesyesin (food discovery & ordering) and libreQuiz (real-time multiplayer room synchronization and live leaderboards)."
		],
		links: [
			{ label: "renazteknik.com Live", href: "https://renazteknik.com" }
		]
	},
	{
		id: "linux-tooling",
		category: "Linux Systems & Intelligent Automation",
		period: "2024 – 2026",
		title: "Freelancer Job Scorer & Void/Arch Linux Workflow Suite",
		subtitle: "Persona-aware job ranking CLI and low-footprint X11 desktop automation",
		stack: ["Python", "Bash", "Linux (Void / Arch)", "X11 / DWM", "REST APIs", "Regex Scoring"],
		bullets: [
			"Built an automated Freelancer.com API ingestion and scoring engine in Python that filters hundreds of listings against persona rules, skill weights, bid competition, and budget ratios.",
			"Maintains a custom minimalist Void/Arch Linux environment with automated window management, audio/display scripting, and containerized self-hosted services."
