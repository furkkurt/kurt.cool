---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import bgImage from '../assets/bg.jpg';

interface GitHubRepo {
	name: string;
	description: string | null;
	html_url: string;
	language: string | null;
	updated_at: string;
	stargazers_count: number;
	forks_count: number;
}

let repos: GitHubRepo[] = [];
let error: string | null = null;

try {
	const response = await fetch('https://api.github.com/users/furkkurt/repos?sort=updated&per_page=100', {
		headers: {
			'Accept': 'application/vnd.github.v3+json',
		},
	});
	
	if (response.ok) {
		repos = await response.json();
		// Filter out forks and archived repos for cleaner display
		repos = repos.filter(repo => !repo.name.includes('Uh oh') && !repo.name.toLowerCase().includes('test'));
	} else {
		error = 'Failed to fetch repositories';
	}
} catch (e) {
	error = 'Error loading repositories';
	console.error(e);
}

const getLanguageColor = (language: string | null): string => {
	if (!language) return 'bg-gray-100 text-gray-800';
	const colors: Record<string, string> = {
		'JavaScript': 'bg-yellow-100 text-yellow-800',
		'TypeScript': 'bg-blue-100 text-blue-800',
		'HTML': 'bg-orange-100 text-orange-800',
		'CSS': 'bg-purple-100 text-purple-800',
		'Dart': 'bg-cyan-100 text-cyan-800',
		'C#': 'bg-green-100 text-green-800',
		'Python': 'bg-indigo-100 text-indigo-800',
		'C++': 'bg-pink-100 text-pink-800',
		'Rust': 'bg-amber-100 text-amber-900',
		'Shell': 'bg-emerald-100 text-emerald-800',
		'Astro': 'bg-orange-100 text-orange-800',
	};
	return colors[language] || 'bg-gray-100 text-gray-800';
};

const featuredProjects = [
	{
		id: "temple-engine",
		category: "3D Graphics & Game Engine (B.Sc. Capstone)",
		period: "2025 – 2026",
		title: "Temple Engine — Web-Based 3D Game Engine & Visual Editor",
		subtitle: "Full-featured browser 3D game engine, visual scene editor, and standalone HTML5 exporter",
		stack: ["TypeScript", "Three.js (WebGL)", "FastAPI", "Python", "GLSL Shaders", "Vite", "SQLite"],
		bullets: [
			"Architected a decoupled Engine Core & Editor UI with a 60 FPS WebGL viewport, transform gizmos (translate/rotate/scale), Scene Hierarchy, Inspector, and Asset Browser.",
			"Built a custom Terrain & Environment System supporting heightmap sculpting, multi-layer texture splatting, procedural skybox/fog, and real-time GPU particle emitters.",
			"Implemented a FastAPI backend with JWT authentication, cloud project persistence, multi-format 3D asset pipeline (GLTF/GLB/OBJ), and one-click standalone HTML5 game export."
		],
		links: [
			{ label: "Portfolio PDF (EN)", href: "/Ahmet_Furkan_Kurt_Portfolio_EN.pdf" }
		]
	},
	{
		id: "hand-gesture-hmi",
		category: "Computer Vision & Real-Time HMI",
		period: "2025",
		title: "Real-Time Hand Gesture Recognition & Contactless OS Control",
		subtitle: "30 FPS 3D hand landmark tracking and jitter-free OS cursor/event pipeline",
		stack: ["Python", "OpenCV", "MediaPipe Hands 3D", "NumPy", "PyAutoGUI / X11"],
		bullets: [
			"Engineered a low-latency 30 FPS webcam pipeline extracting 21 3D hand landmarks per frame to enable contactless desktop navigation and command execution.",
			"Designed scale-invariant gesture classification using Euclidean distance ratios normalized against palm size, combined with state hysteresis to prevent false triggers.",
			"Eliminated sensor micro-jitter via an Exponential Moving Average (EMA) coordinate filter and dead-zone thresholding for smooth, sub-pixel cursor control on Linux X11."
		],
		links: []
	},
	{
		id: "boutique-lavinia",
		category: "Full-Stack Enterprise E-Commerce",
		period: "2025 – 2026",
		title: "Boutique Lavinia — Modular .NET 8 & Next.js 14 E-Commerce",
		subtitle: "Multi-layered enterprise backend, RBAC admin suite, and SSR storefront",
		stack: [".NET 8 Web API", "C#", "EF Core", "PostgreSQL", "Next.js 14", "TypeScript", "Tailwind CSS"],
		bullets: [
			"Designed a multi-project .NET 8 architecture (API, Core, Application, Infrastructure) utilizing Repository/Unit-of-Work patterns and JWT role-based access control.",
			"Built dynamic product variant inventory tracking (size/color matrices), automated coupon/campaign validation rules, and multi-stage order lifecycle state machines.",
			"Developed a responsive Next.js 14 App Router storefront and comprehensive Admin Analytics Dashboard with SSR metadata optimization."
		],
		links: []
	},
	{
		id: "news-engine",
		category: "Clean Architecture & CQRS Backend",
		period: "2025 – 2026",
		title: "NewsEngine (fikrimce.net) — .NET 10 CQRS Publishing Platform",
		subtitle: "4-layer Clean Architecture digital media engine with MediatR pipelines",
		stack: [".NET 10", "C#", "CQRS & MediatR", "FluentValidation", "EF Core 10", "Serilog", "Docker", "Nginx"],
		bullets: [
			"Architected a strict 4-layer Clean Architecture backend (Domain, Application, Infrastructure, WebAPI) separating read and write workloads via MediatR CQRS handlers.",
			"Implemented automated FluentValidation pipeline behaviors, structured Serilog telemetry, and slug-indexed article query optimization.",
			"Containerized the full stack with multi-stage Dockerfiles and deployed behind an Nginx reverse proxy with automated SSL."
		],
		links: []
	},
	{
		id: "ashes-touch",
		category: "Systems Programming & Custom Game Engine",
		period: "2025 – 2026",
		title: "Ashe's Touch — First-Person 3D Retro Dungeon Crawler in Rust",
		subtitle: "Custom grid-based 3D engine compiled to a 1.44 MB native binary",
		stack: ["Rust (2021)", "Macroquad", "GLSL Shaders", "Raycasting / 3D Billboards", "Procedural Audio"],
		bullets: [
			"Built a classic Eye of the Beholder-style first-person dungeon crawler in Rust featuring 90° grid navigation, 3D perspective corridor rendering, and a 4-hero party combat system.",
			"Wrote an offscreen 320x240 pixel-art render pipeline with custom GLSL CRT scanline/curvature post-processing shaders and a real-time automap overlay.",
			"Synthesized retro sound effects procedurally at runtime and tuned Cargo LTO/strip profiles to package the entire game into a single 1.44 MB executable."
