const formatDate = (dateString: string): string => {
	const date = new Date(dateString);
	return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<Layout title="Projects - Ahmet Furkan Kurt" description="Featured engineering case studies and GitHub repositories by Ahmet Furkan Kurt">
	<Navigation />
	
	<!-- Background -->
	<div id="page-bg">
		<img src={bgImage.src} alt="" id="bg-image" />
		<div class="overlay"></div>
	</div>
	
	<div class="min-h-screen pt-20 relative">
		<div class="max-w-7xl mx-auto px-6 py-12">
			<div class="mb-10 glass-soft p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
				<div>
					<a href="/#projects" class="font-medium inline-flex items-center gap-2 mb-4" style="color: var(--accent-primary);">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Back to Home
					</a>
					<h1 class="text-4xl md:text-5xl font-black mb-3" style="color: white;">Engineering Projects</h1>
					<p class="text-base md:text-lg secondary-text max-w-2xl">
						Deep-dive architectural case studies across 3D graphics engines, enterprise .NET backends, computer vision, and cross-platform applications.
					</p>
				</div>
				<div class="flex flex-wrap gap-3">
					<a
						href="/Ahmet_Furkan_Kurt_Portfolio_EN.pdf"
						download="Ahmet_Furkan_Kurt_Portfolio_EN.pdf"
						class="px-5 py-3 rounded-lg font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 inline-flex items-center gap-2 text-sm"
						style="background-color: var(--accent-primary); color: white;"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						Portfolio PDF (EN)
					</a>
					<a
						href="/Ahmet_Furkan_Kurt_Portfoy_TR.pdf"
						download="Ahmet_Furkan_Kurt_Portfoy_TR.pdf"
						class="px-5 py-3 rounded-lg font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 inline-flex items-center gap-2 text-sm"
						style="background-color: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.35); color: white;"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						Portföy PDF (TR)
					</a>
				</div>
			</div>

			<!-- Featured Case Studies -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold mb-6" style="color: white;">Flagship Architecture &amp; Engineering Case Studies</h2>
				<div class="grid md:grid-cols-2 gap-6">
					{featuredProjects.map((proj) => (
						<div id={proj.id} class="glass-soft rounded-xl p-6 md:p-8 flex flex-col justify-between scroll-mt-24">
							<div>
								<div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
									<span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full" style="background-color: rgba(255,255,255,0.15); color: var(--accent-primary);">
										{proj.category}
									</span>
									<span class="text-xs secondary-text">{proj.period}</span>
								</div>
								<h3 class="text-xl md:text-2xl font-bold mb-1" style="color: white;">{proj.title}</h3>
								<p class="text-sm secondary-text mb-4">{proj.subtitle}</p>
								<div class="flex flex-wrap gap-2 mb-4">
									{proj.stack.map((tech) => (
										<span class="px-2.5 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">
											{tech}
										</span>
									))}
								</div>
								<ul class="space-y-2 mb-4">
									{proj.bullets.map((bullet) => (
										<li class="flex items-start gap-2 text-xs md:text-sm secondary-text leading-relaxed">
											<span class="mt-1" style="color: var(--accent-primary);">•</span>
											<span>{bullet}</span>
										</li>
									))}
								</ul>
							</div>
							{proj.links.length > 0 && (
								<div class="flex gap-4 pt-2 border-t border-white/15">
									{proj.links.map((link) => (
										<a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold inline-flex items-center gap-1" style="color: var(--accent-primary);">
											{link.label} →
										</a>
									))}
								</div>
							)}
						</div>
					))}
				</div>
			</div>

			<!-- GitHub Repositories -->
			<div class="mb-6">
				<h2 class="text-2xl md:text-3xl font-bold mb-2" style="color: white;">Open-Source &amp; GitHub Repositories</h2>
				<p class="text-sm md:text-base secondary-text mb-6">Live feed of public repositories from github.com/furkkurt</p>
			</div>

			{error ? (
				<div class="glass-soft p-6">
					<p style="color: rgba(255, 100, 100, 0.9);">{error}</p>
				</div>
			) : (
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					{repos.map((repo) => (
						<a 
							href={repo.html_url} 
							target="_blank" 
							rel="noopener noreferrer"
							class="glass-soft rounded-xl p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 group"
						>
							<div class="flex items-start justify-between mb-3">
								<h3 class="text-xl font-bold group-hover:opacity-80 transition-colors flex-1" style="color: white;">
									{repo.name}
								</h3>
								<svg class="w-5 h-5 secondary-text group-hover:opacity-100 transition-colors flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
								</svg>
							</div>
							
							{repo.description && (
								<p class="secondary-text mb-4 line-clamp-2">{repo.description}</p>
							)}
							
							<div class="flex items-center gap-4 flex-wrap">
								{repo.language && (
									<span class="px-3 py-1 rounded-full text-sm font-medium" style="background-color: var(--accent-primary); color: white; opacity: 0.8;">
										{repo.language}
									</span>
								)}
								<div class="flex items-center gap-4 text-sm secondary-text">
									{repo.stargazers_count > 0 && (
										<span class="flex items-center gap-1">
											<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
												<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
											</svg>
											{repo.stargazers_count}
										</span>
									)}
									{repo.forks_count > 0 && (
										<span class="flex items-center gap-1">
											<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
												<path d="M7.707 10.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V6h5a2 2 0 012 2v7a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2h5v5.586l-1.293-1.293zM9 4a1 1 0 012 0v2H9V4z"></path>
											</svg>
											{repo.forks_count}
										</span>
									)}
								</div>
							</div>
							
							<div class="mt-4 text-xs secondary-text">
								Updated {formatDate(repo.updated_at)}
							</div>
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</Layout>

<style>
	/* Background layer - same as home page */
	#page-bg {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	
	#bg-image {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: translate(-50%, -50%) scale(1.0);
		will-change: transform;
		z-index: 1;
	}
	
	#page-bg .overlay {
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.68);
		pointer-events: none;
		z-index: 2;
	}
	
	main, nav, section, footer {
		position: relative;
		z-index: 10;
	}
	
	/* Glass overlay system with glow animation */
	.glass-soft {
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(12px);
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.1), 0 0 40px rgba(255, 255, 255, 0.05);
		animation: card-glow-pulse 4s ease-in-out infinite;
	}
	
	@keyframes card-glow-pulse {
		0%, 100% {
			box-shadow: 0 0 20px rgba(255, 255, 255, 0.1), 0 0 40px rgba(255, 255, 255, 0.05);
		}
		50% {
			box-shadow: 0 0 25px rgba(255, 255, 255, 0.15), 0 0 50px rgba(255, 255, 255, 0.08), 0 0 60px rgba(255, 255, 255, 0.03);
		}
	}
	
	.secondary-text {
		color: rgba(255, 255, 255, 0.65) !important;
	}
	
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
