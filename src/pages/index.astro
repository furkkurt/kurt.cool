---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { getImage } from 'astro:assets';
import meSketch from '../assets/meSketch.png';
import monitor11 from '../assets/monitor11.png';
import monitor12 from '../assets/monitor12.png';
import monitor21 from '../assets/monitor21.png';
import monitor22 from '../assets/monitor22.png';
import monitor31 from '../assets/monitor31.png';
import monitor32 from '../assets/monitor32.png';
import bgImage from '../assets/bg.jpg';

// Optimize images to WebP format
const optimizedBg = await getImage({ src: bgImage, format: 'webp', quality: 85 });
const optimizedSketch = await getImage({ src: meSketch, format: 'webp', quality: 90 });
const optimizedMonitor11 = await getImage({ src: monitor11, format: 'webp', quality: 85 });
const optimizedMonitor12 = await getImage({ src: monitor12, format: 'webp', quality: 85 });
const optimizedMonitor21 = await getImage({ src: monitor21, format: 'webp', quality: 85 });
const optimizedMonitor22 = await getImage({ src: monitor22, format: 'webp', quality: 85 });
const optimizedMonitor31 = await getImage({ src: monitor31, format: 'webp', quality: 85 });
const optimizedMonitor32 = await getImage({ src: monitor32, format: 'webp', quality: 85 });

// Image dimensions are accessed directly from imported images for CLS prevention
---

<Layout>
	<Navigation />
	
	<main>
	<!-- Background -->
	<div id="page-bg" data-bg="sketch">
		<img 
			src={optimizedBg.src} 
			srcset={optimizedBg.srcSet.attribute}
			alt="" 
			id="bg-image"
			width={bgImage.width || 1920}
			height={bgImage.height || 1080}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="overlay"></div>
	</div>
	
	<!-- Hero Section -->
	<section class="flex items-center justify-center pt-24 md:pt-20 pb-12 md:pb-16 px-4 md:px-6 relative hero-section" style="z-index: 1;">
		<div class="max-w-6xl mx-auto relative z-10 w-full">
			<!-- Desktop Layout: Side by side -->
			<div class="hidden md:grid md:grid-cols-2 gap-12 items-center">
				<div class="flex justify-center animate-float">
					<div class="relative">
						<div class="absolute inset-0 rounded-full blur-2xl opacity-20 animate-pulse-slow" style="background: linear-gradient(to right, var(--accent-primary), var(--accent-primary));"></div>
						<div class="relative" style="mask-image: linear-gradient(to top, transparent 0%, transparent 15%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.4) 35%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.8) 55%, black 65%, black 100%); -webkit-mask-image: linear-gradient(to top, transparent 0%, transparent 15%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.4) 35%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.8) 55%, black 65%, black 100%);">
							<img 
								src={optimizedSketch.src} 
								srcset={optimizedSketch.srcSet.attribute}
								alt="Furkan Kurt Sketch" 
								class="w-full max-w-md animate-rock drop-shadow-2xl transform hover:scale-105 transition-transform sketch-image"
								width={meSketch.width || 665}
								height={meSketch.height || 707}
								loading="eager"
								fetchpriority="high"
							/>
						</div>
					</div>
				</div>
				<div class="monitor-stage animate-fade-in">
					<div class="monitor-wrap monitor-rock">
						<div class="monitor-screen">
							<img src={optimizedMonitor11.src} srcset={optimizedMonitor11.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-11" width={monitor11.width || 800} height={monitor11.height || 600} loading="lazy" />
							<img src={optimizedMonitor12.src} srcset={optimizedMonitor12.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-12" width={monitor12.width || 800} height={monitor12.height || 600} loading="lazy" />
							<img src={optimizedMonitor21.src} srcset={optimizedMonitor21.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-21" width={monitor21.width || 800} height={monitor21.height || 600} loading="lazy" />
							<img src={optimizedMonitor22.src} srcset={optimizedMonitor22.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-22" width={monitor22.width || 800} height={monitor22.height || 600} loading="lazy" />
							<img src={optimizedMonitor31.src} srcset={optimizedMonitor31.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-31" width={monitor31.width || 800} height={monitor31.height || 600} loading="lazy" />
							<img src={optimizedMonitor32.src} srcset={optimizedMonitor32.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-32" width={monitor32.width || 800} height={monitor32.height || 600} loading="lazy" />
						</div>
					</div>
				</div>
			</div>
			
			<!-- Mobile Layout: Swipeable carousel -->
			<div class="md:hidden hero-swipeable-container" data-slide="0">
				<div class="hero-swipeable-wrapper">
					<!-- Sketch Slide -->
					<div class="hero-slide hero-slide-active sketch-slide">
						<div class="flex justify-center items-center w-full">
							<div class="relative w-full max-w-full">
								<div class="absolute inset-0 rounded-full blur-2xl opacity-20 animate-pulse-slow" style="background: linear-gradient(to right, var(--accent-primary), var(--accent-primary));"></div>
								<div class="relative" style="mask-image: linear-gradient(to top, transparent 0%, transparent 15%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.4) 35%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.8) 55%, black 65%, black 100%); -webkit-mask-image: linear-gradient(to top, transparent 0%, transparent 15%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.4) 35%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.8) 55%, black 65%, black 100%);">
									<img 
										src={optimizedSketch.src} 
										srcset={optimizedSketch.srcSet.attribute}
										alt="Furkan Kurt Sketch" 
										class="w-full max-w-full animate-rock drop-shadow-2xl transform hover:scale-105 transition-transform sketch-image-mobile"
										width={meSketch.width || 665}
										height={meSketch.height || 707}
										loading="eager"
										fetchpriority="high"
									/>
								</div>
							</div>
						</div>
					</div>
					<!-- Monitor Slide -->
					<div class="hero-slide monitor-slide">
						<div class="monitor-stage-mobile w-full flex justify-center items-center">
							<div class="monitor-wrap-mobile w-full max-w-full monitor-rock">
								<div class="monitor-screen">
									<img src={optimizedMonitor11.src} srcset={optimizedMonitor11.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-11" width={monitor11.width || 800} height={monitor11.height || 600} loading="lazy" />
									<img src={optimizedMonitor12.src} srcset={optimizedMonitor12.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-12" width={monitor12.width || 800} height={monitor12.height || 600} loading="lazy" />
									<img src={optimizedMonitor21.src} srcset={optimizedMonitor21.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-21" width={monitor21.width || 800} height={monitor21.height || 600} loading="lazy" />
									<img src={optimizedMonitor22.src} srcset={optimizedMonitor22.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-22" width={monitor22.width || 800} height={monitor22.height || 600} loading="lazy" />
									<img src={optimizedMonitor31.src} srcset={optimizedMonitor31.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-31" width={monitor31.width || 800} height={monitor31.height || 600} loading="lazy" />
									<img src={optimizedMonitor32.src} srcset={optimizedMonitor32.srcSet.attribute} alt="Monitor Content" class="monitor-content-image monitor-img-32" width={monitor32.width || 800} height={monitor32.height || 600} loading="lazy" />
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- Slide Indicators -->
				<div class="hero-indicators">
					<button class="hero-indicator hero-indicator-active" data-slide="0" aria-label="Show sketch"></button>
					<button class="hero-indicator" data-slide="1" aria-label="Show monitor"></button>
				</div>
			</div>
		</div>
	</section>

	<!-- Selected Projects -->
	<section id="projects" class="relative w-full py-16 md:py-24">
		<div class="mx-auto max-w-6xl px-4 relative z-10">
			<div class="overlay-soft p-6 md:p-8">
				<h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 text-center">Selected Projects</h2>
				<p class="text-center secondary-text mb-12 md:mb-16 max-w-2xl mx-auto text-sm md:text-base">
					Flagship engineering systems spanning 3D graphics engines, enterprise .NET architectures, real-time computer vision, and high-performance web &amp; mobile platforms.
				</p>
				<div class="cards-grid">
					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">B.Sc. Capstone</span>
								<span class="text-xs secondary-text">2025 – 2026</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">Temple Engine</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">Web-Based 3D Game Engine &amp; Visual Scene Editor</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">TypeScript</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Three.js (WebGL)</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">FastAPI</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">GLSL</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Architected a browser-based 3D engine and Unity-style IDE featuring a 60 FPS WebGL viewport, transform gizmos, Scene Hierarchy, Inspector, Asset Browser, procedural Terrain Editor, particle systems, and one-click standalone HTML5 export.
							</p>
						</div>
						<a href="/projects#temple-engine" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							Architecture Details →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">Computer Vision &amp; HMI</span>
								<span class="text-xs secondary-text">2025</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">Real-Time Hand Gesture HMI</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">Contactless 3D Hand Landmark &amp; OS Input Pipeline</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Python</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">OpenCV</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">MediaPipe 3D</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Linux X11</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Built a low-latency 30 FPS webcam pipeline tracking 21 3D hand landmarks in real time. Uses Euclidean distance ratios, exponential moving-average smoothing, and state hysteresis to synthesize jitter-free OS cursor and click events.
							</p>
						</div>
						<a href="/projects#hand-gesture-hmi" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							View Case Study →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">Full-Stack Enterprise</span>
								<span class="text-xs secondary-text">2025 – 2026</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">Boutique Lavinia Platform</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">Modular .NET 8 &amp; Next.js 14 E-Commerce Ecosystem</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">.NET 8 Web API</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Next.js 14</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">TypeScript</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">PostgreSQL</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Engineered a multi-project .NET 8 solution (API, Core, Application, Infrastructure) with JWT RBAC, dynamic variant/stock tracking, coupon engine, analytics dashboard, and a responsive Next.js 14 App Router storefront.
							</p>
						</div>
						<a href="/projects#boutique-lavinia" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							Architecture Details →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">Clean Architecture</span>
								<span class="text-xs secondary-text">2025 – 2026</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">NewsEngine (fikrimce.net)</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">.NET 10 CQRS Digital Publishing &amp; News Platform</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">.NET 10</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">CQRS &amp; MediatR</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">EF Core 10</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Docker</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Designed a 4-layer Clean Architecture backend utilizing MediatR CQRS pipelines, FluentValidation behaviors, and Serilog structured telemetry, paired with an editorial CMS and containerized with Docker &amp; Nginx.
							</p>
						</div>
						<a href="/projects#news-engine" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							Architecture Details →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">Systems &amp; Game Engine</span>
								<span class="text-xs secondary-text">2025 – 2026</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">Ashe's Touch (Rust Engine)</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">First-Person 3D Retro Dungeon Crawler in Rust</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Rust (2021)</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Macroquad</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">GLSL CRT Shader</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">1.44 MB Binary</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Built a grid-based 3D dungeon crawler from scratch in Rust with an internal 320x240 render target, custom GLSL CRT post-processing shaders, procedural audio synthesis, and LTO binary stripping down to a 1.44 MB executable.
							</p>
						</div>
						<a href="/projects#ashes-touch" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							View Case Study →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">VR Simulation</span>
								<span class="text-xs secondary-text">2025</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">VR Earthquake Drill Simulation</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">Quest VR Emergency Training (24 → 60 FPS Optimization)</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Unity 3D</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">C#</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">XR Interaction Toolkit</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">GPU Instancing</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Developed an interactive VR earthquake response simulation with realistic physics and spatial audio. Boosted standalone VR frame rates from 24 FPS to a rock-solid 60 FPS via draw-call batching, baked lightmaps, and physics decimation.
							</p>
						</div>
						<a href="/projects#vr-earthquake" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							View Case Study →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">AI Developer Tooling</span>
								<span class="text-xs secondary-text">2025 – 2026</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">LLM Code Evaluation Workstation</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">Side-by-Side AI Model Benchmarking &amp; Live Sandbox</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">TypeScript</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Node.js / Express</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">OpenRouter API</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Built an interactive AI benchmarking platform to test multiple LLMs concurrently on identical coding prompts, rendering generated HTML/CSS/JS inside isolated sandboxed iframes while tracking latency and token costs.
							</p>
						</div>
						<a href="/projects#llm-eval" class="font-medium inline-flex items-center gap-2 text-sm md:text-base">
							View Case Study →
						</a>
					</div>

					<div class="card glass-soft p-6 md:p-8 hover:shadow-lg transition-all duration-300 animate-slide-up flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-2">
								<span class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.14); color: var(--accent-primary);">Web Perf &amp; Mobile</span>
								<span class="text-xs secondary-text">Production</span>
							</div>
							<h3 class="text-xl md:text-2xl font-bold mb-2" style="color: white;">renazteknik.com &amp; Flutter Apps</h3>
							<p class="mb-4 text-sm md:text-base secondary-text">100/100 Lighthouse Web &amp; Cross-Platform Mobile Suite</p>
							<div class="flex flex-wrap gap-2 mb-4">
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Astro</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Flutter</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Riverpod</span>
								<span class="px-3 py-1 rounded-full text-xs font-medium" style="background-color: var(--accent-secondary); color: white;">Firebase</span>
							</div>
							<p class="mb-4 text-xs md:text-sm leading-relaxed secondary-text">
								Delivered renazteknik.com with 100/100 Google Lighthouse scores across all four metrics, alongside cross-platform Flutter applications (Herkesyesin &amp; libreQuiz) featuring real-time multiplayer state synchronization.
							</p>
						</div>
						<div class="flex items-center gap-4">
							<a href="https://renazteknik.com" target="_blank" rel="noopener noreferrer" class="font-medium inline-flex items-center gap-1 text-sm md:text-base">
								Live Site →
							</a>
							<a href="/projects#mobile-web" class="font-medium inline-flex items-center gap-1 text-sm md:text-base opacity-80 hover:opacity-100">
								Details →
							</a>
						</div>
					</div>
				</div>
				<div class="text-center mt-10 md:mt-12">
