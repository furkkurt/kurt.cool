<script>
	// Scroll to top button (desktop only to avoid scroll conflicts on mobile)
	const scrollToTopBtn = document.getElementById('scroll-to-top');
	
	if (scrollToTopBtn) {
		// Only add scroll listener on desktop
		if (window.innerWidth > 768) {
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					scrollToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
					scrollToTopBtn.classList.add('opacity-100');
				} else {
					scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none');
					scrollToTopBtn.classList.remove('opacity-100');
				}
			});
		}
		
		scrollToTopBtn.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	}

	// Intersection Observer for scroll animations
	const observerOptions = {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				const target = entry.target as HTMLElement;
				target.classList.add('animate-slide-up');
				target.style.opacity = '1';
			}
		});
	}, observerOptions);

	// Observe all sections
	document.querySelectorAll('section > div').forEach(el => {
		const element = el as HTMLElement;
		element.style.opacity = '0';
		observer.observe(element);
	});

	// Mobile Hero Swipeable Carousel
	(() => {
		const container = document.querySelector('.hero-swipeable-container') as HTMLElement | null;
		const wrapper = document.querySelector('.hero-swipeable-wrapper') as HTMLElement | null;
		const slides = document.querySelectorAll('.hero-slide');
		const indicators = document.querySelectorAll('.hero-indicator');
		const pageBg = document.getElementById('page-bg');
		
		if (!container || !wrapper || slides.length === 0) return;
		
		let currentSlide = 0;
		let startX = 0;
		let currentX = 0;
		let isDragging = false;
		let startTime = 0;
		const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
		
		const updateSlide = (index: number) => {
			if (index < 0 || index >= slides.length) return;
			
			currentSlide = index;
			
			// Mobile: state-based (no translate). Desktop: translate.
			if (isMobile()) {
				container.setAttribute('data-slide', String(currentSlide));
				if (pageBg) pageBg.setAttribute('data-bg', currentSlide === 0 ? 'sketch' : 'monitor');
				if (wrapper) wrapper.style.transform = '';
			} else {
				if (wrapper) wrapper.style.transform = `translateX(-${currentSlide * 100}%)`;
			}
			
			// Update indicators
			indicators.forEach((indicator, i) => {
				if (i === currentSlide) {
					indicator.classList.add('hero-indicator-active');
					slides[i].classList.add('hero-slide-active');
				} else {
					indicator.classList.remove('hero-indicator-active');
					slides[i].classList.remove('hero-slide-active');
				}
			});
		};
		
		// Touch events
		container.addEventListener('touchstart', (e) => {
			const touchEvent = e as TouchEvent;
			if (isMobile()) {
				// Mobile: no live dragging transforms
				startX = touchEvent.touches[0].clientX;
				currentX = startX;
				startTime = Date.now();
				isDragging = true;
				return;
			}
			startX = touchEvent.touches[0].clientX;
			startTime = Date.now();
			isDragging = true;
			if (wrapper) wrapper.style.transition = 'none';
		}, { passive: true });
		
		container.addEventListener('touchmove', (e) => {
			const touchEvent = e as TouchEvent;
			if (!isDragging) return;
			if (isMobile()) {
				currentX = touchEvent.touches[0].clientX;
				return;
			}
			currentX = touchEvent.touches[0].clientX;
			const diff = currentX - startX;
			const translateX = -currentSlide * 100 + (diff / (container?.offsetWidth || 1)) * 100;
			
			// Prevent scrolling past boundaries
			if (translateX > 0) {
				if (wrapper) wrapper.style.transform = `translateX(0%)`;
			} else if (translateX < -(slides.length - 1) * 100) {
				if (wrapper) wrapper.style.transform = `translateX(-${(slides.length - 1) * 100}%)`;
			} else {
				if (wrapper) wrapper.style.transform = `translateX(${translateX}%)`;
			}
		}, { passive: true });
		
		container.addEventListener('touchend', () => {
			if (!isDragging) return;
			isDragging = false;
			if (!isMobile()) {
				if (wrapper) wrapper.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
			}
			
			const diff = currentX - startX;
			const timeDiff = Date.now() - startTime;
			const threshold = (container?.offsetWidth || 0) * 0.25; // 25% of width
			const velocity = Math.abs(diff / timeDiff);
			
			// Determine if we should switch slides
			if (Math.abs(diff) > threshold || velocity > 0.5) {
				if (diff > 0 && currentSlide > 0) {
					updateSlide(currentSlide - 1);
				} else if (diff < 0 && currentSlide < slides.length - 1) {
					updateSlide(currentSlide + 1);
				} else {
					updateSlide(currentSlide);
				}
			} else {
				updateSlide(currentSlide);
			}
		});
		
		// Mouse events for desktop testing
		container.addEventListener('mousedown', (e: MouseEvent) => {
			startX = e.clientX;
			startTime = Date.now();
			isDragging = true;
			if (wrapper) wrapper.style.transition = 'none';
			e.preventDefault();
		});
		
		container.addEventListener('mousemove', (e: MouseEvent) => {
			if (!isDragging) return;
			currentX = e.clientX;
			const diff = currentX - startX;
			const translateX = -currentSlide * 100 + (diff / (container?.offsetWidth || 1)) * 100;
			
			if (translateX > 0) {
				if (wrapper) wrapper.style.transform = `translateX(0%)`;
			} else if (translateX < -(slides.length - 1) * 100) {
				if (wrapper) wrapper.style.transform = `translateX(-${(slides.length - 1) * 100}%)`;
			} else {
				if (wrapper) wrapper.style.transform = `translateX(${translateX}%)`;
			}
		});
		
		container.addEventListener('mouseup', () => {
			if (!isDragging) return;
			isDragging = false;
			wrapper.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
			
			const diff = currentX - startX;
			const timeDiff = Date.now() - startTime;
			const threshold = (container?.offsetWidth || 0) * 0.25;
			const velocity = Math.abs(diff / timeDiff);
			
			if (Math.abs(diff) > threshold || velocity > 0.5) {
				if (diff > 0 && currentSlide > 0) {
					updateSlide(currentSlide - 1);
				} else if (diff < 0 && currentSlide < slides.length - 1) {
					updateSlide(currentSlide + 1);
				} else {
					updateSlide(currentSlide);
				}
			} else {
				updateSlide(currentSlide);
			}
		});
		
		container.addEventListener('mouseleave', () => {
			if (isDragging) {
				isDragging = false;
				if (wrapper) wrapper.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
				updateSlide(currentSlide);
			}
		});
		
		// Indicator clicks
		indicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => {
				updateSlide(index);
			});
		});
		
		// Initialize
		updateSlide(0);
		
		// Keep background + state stable on breakpoint changes
		let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
		let wasMobile = isMobile();
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(() => {
				const nowMobile = isMobile();
				// Only update if we actually crossed the breakpoint
				if (wasMobile !== nowMobile) {
					wasMobile = nowMobile;
					// Force re-apply slide state to sync background
					const currentState = container.getAttribute('data-slide') || String(currentSlide);
					updateSlide(parseInt(currentState, 10));
				} else {
					// Just re-apply current state to ensure sync
					updateSlide(currentSlide);
				}
			}, 150);
		});
	})();

	// Speed-based drift + shake effect with dream-like zoom (DESKTOP ONLY)
	(() => {
		const imgEl = document.getElementById('bg-image') as HTMLElement;
		if (!imgEl) return;

		const isMobile = () => window.innerWidth < 768;
		
		// Check if mobile - disable all transforms on mobile
		if (isMobile()) {
			// On mobile, ensure no transforms are applied
			imgEl.style.transform = 'none';
			imgEl.style.willChange = 'opacity';
			return;
		}

		// Desktop only settings
		const MIN_SCALE = 1.0;        // zoom out when stopped (show max size)
		const MAX_SCALE = 1.22;       // zoom in when scrolling
		const MAX_Y = 55;             // max vertical drift in px
		const MAX_X = 10;             // max horizontal shake in px
		const MAX_ROT = 0.6;          // optional slight rotation in deg
		const SPEED_NORM = 1200;      // larger = less sensitive to speed
		const SMOOTH = 0.05;           // damping for position
		const ZOOM_SMOOTH = 0.015;     // very slow zoom animation

		let lastY = window.scrollY;
		let lastT = performance.now();
		let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
		let isScrolling = false;

		let targetX = 0, targetY = 0, targetRot = 0, targetScale = MIN_SCALE;
		let x = 0, y = 0, rot = 0, scale = MIN_SCALE;

		let phase = 0; // for oscillation
		let raf = 0;

		function clamp(v: number, a: number, b: number): number {
			return Math.max(a, Math.min(b, v));
		}
		function lerp(a: number, b: number, t: number): number {
			return a + (b - a) * t;
		}

		function tick(now: number) {
			// Re-check mobile on resize
			if (window.innerWidth < 768) {
				imgEl.style.transform = 'none';
				cancelAnimationFrame(raf);
				return;
			}

			const dy = window.scrollY - lastY;
			const dt = Math.max(8, now - lastT); // ms
			lastY = window.scrollY;
			lastT = now;

			// Detect scrolling state
			if (Math.abs(dy) > 0.5) {
				isScrolling = true;
				// Clear timeout if scrolling
				if (scrollTimeout) {
					clearTimeout(scrollTimeout);
					scrollTimeout = null;
				}
				// Set timeout to detect when scrolling stops
				scrollTimeout = setTimeout(() => {
					isScrolling = false;
				}, 150);
			}

			// Zoom based on scroll state
			if (isScrolling) {
				targetScale = MAX_SCALE; // zoom in when scrolling
			} else {
				targetScale = MIN_SCALE; // zoom out when stopped
			}

			// px/s velocity (signed)
			const v = (dy / dt) * 1000;

			// Normalize speed 0..1
			const speed = clamp(Math.abs(v) / SPEED_NORM, 0, 1);

			// Drift follows direction: scroll down => move bg up slightly (negative translateY)
			targetY = clamp(-v * 0.02, -MAX_Y, MAX_Y);

			// Horizontal "shake": oscillation + tiny random, scales with speed
			phase += (0.08 + speed * 0.22);
			const osc = Math.sin(phase) * (MAX_X * speed);

			// small jitter component (kept subtle)
			const jitter = (Math.random() - 0.5) * 2 * (MAX_X * 0.15 * speed);

			targetX = clamp(osc + jitter, -MAX_X, MAX_X);

			// Optional: tiny rotation for "handheld" feel (also speed-based)
			targetRot = clamp((Math.sin(phase * 0.7) * MAX_ROT) * speed, -MAX_ROT, MAX_ROT);

			// Smooth towards targets
			x = lerp(x, targetX, SMOOTH);
			y = lerp(y, targetY, SMOOTH);
			rot = lerp(rot, targetRot, SMOOTH);
			scale = lerp(scale, targetScale, ZOOM_SMOOTH); // Very slow zoom animation

			imgEl.style.transform =
				`translate(-50%, -50%) translate3d(${x}px, ${y}px, 0) rotate(${rot}deg) scale(${scale})`;

			raf = requestAnimationFrame(tick);
		}

		raf = requestAnimationFrame(tick);

		// Safety: pause when tab hidden
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) cancelAnimationFrame(raf);
			else {
				lastY = window.scrollY;
				lastT = performance.now();
				raf = requestAnimationFrame(tick);
			}
		});

		// Handle resize - properly switch between mobile/desktop modes
		let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
		let wasMobile = isMobile();
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(() => {
				const nowMobile = isMobile();
				if (nowMobile) {
					// Switch to mobile mode: no transforms, preserve object-position
					imgEl.style.transform = 'none';
					imgEl.style.willChange = 'opacity';
					cancelAnimationFrame(raf);
					// Reset position values
					x = 0;
					y = 0;
					rot = 0;
					scale = MIN_SCALE;
					// Ensure background state is preserved
					const pageBg = document.getElementById('page-bg');
					if (pageBg && !pageBg.getAttribute('data-bg')) {
						// If no bg state exists, set default based on current slide
						const container = document.querySelector('.hero-swipeable-container');
						if (container) {
							const slide = container.getAttribute('data-slide') || '0';
							pageBg.setAttribute('data-bg', slide === '0' ? 'sketch' : 'monitor');
						}
					}
				} else {
					// Switch to desktop mode: restart animation
					imgEl.style.willChange = 'transform';
					lastY = window.scrollY;
					lastT = performance.now();
					raf = requestAnimationFrame(tick);
				}
				wasMobile = nowMobile;
			}, 150);
		});
	})();

</script>

