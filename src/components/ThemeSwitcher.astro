---
const { variant = 'popup' } = Astro.props;
---

<div class="relative theme-switcher" data-theme-switcher data-variant={variant}>
	<button 
		type="button"
		class="theme-button flex items-center gap-2 px-3 py-2 rounded-lg transition-colors"
		aria-label="Change color theme"
		title="Change color theme"
		style="color: var(--text-secondary); touch-action: manipulation;"
	>
		<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
		</svg>
		<span class="theme-name text-sm font-medium">Blue</span>
	</button>
	
	<div
		class:list={[
			'theme-menu',
			'hidden',
			variant === 'popup'
				? 'absolute right-0 top-full mt-2 rounded-lg shadow-lg border py-2 min-w-[140px] z-50'
				: 'mt-3 w-full rounded-lg border py-2',
		]}
		style="background-color: rgba(15, 23, 42, 1); border-color: rgba(255, 255, 255, 0.2);"
	>
		<button 
			type="button"
			data-theme="purple" 
			class="theme-option w-full text-left px-4 py-2 transition-colors text-sm flex items-center gap-2"
			style="color: white;"
		>
			<span class="w-3 h-3 rounded-full bg-[#7C3AED]"></span>
			<span>Muted Purple</span>
		</button>
		<button 
			type="button"
			data-theme="blue" 
			class="theme-option w-full text-left px-4 py-2 transition-colors text-sm flex items-center gap-2"
			style="color: white;"
		>
			<span class="w-3 h-3 rounded-full bg-[#2563EB]"></span>
			<span>Electric Blue</span>
		</button>
		<button 
			type="button"
			data-theme="green" 
			class="theme-option w-full text-left px-4 py-2 transition-colors text-sm flex items-center gap-2"
			style="color: white;"
		>
			<span class="w-3 h-3 rounded-full bg-[#16A34A]"></span>
			<span>Sage Green</span>
		</button>
	</div>
</div>

<script>
	const themes = {
		blue: {
			name: 'Blue',
			colors: {
				'--accent-primary': '#2563EB',
				'--accent-primary-hover': '#1D4ED8',
			}
		},
		purple: {
			name: 'Purple',
			colors: {
				'--accent-primary': '#7C3AED',
				'--accent-primary-hover': '#6D28D9',
			}
		},
		green: {
			name: 'Green',
			colors: {
				'--accent-primary': '#16A34A',
				'--accent-primary-hover': '#15803D',
			}
		}
	};

	function applyTheme(themeName) {
		const theme = themes[themeName];
		if (!theme) return;
		
		const root = document.documentElement;
		Object.entries(theme.colors).forEach(([property, value]) => {
			root.style.setProperty(property, value);
		});
		
		localStorage.setItem('theme', themeName);
	}
	
	function initThemeSwitcher(rootEl) {
		const themeButton = rootEl.querySelector('.theme-button');
		const themeMenu = rootEl.querySelector('.theme-menu');
		const themeNameEl = rootEl.querySelector('.theme-name');
		const options = rootEl.querySelectorAll('.theme-option');
		const variant = rootEl.getAttribute('data-variant') || 'popup';
		
		if (!themeButton || !themeMenu) return;
		
		function updateActiveState(themeName) {
			options.forEach(btn => {
				btn.style.backgroundColor = 'transparent';
				btn.style.color = 'white';
				btn.style.fontWeight = 'normal';
				btn.style.borderLeft = 'none';
			});
			const activeBtn = rootEl.querySelector(`[data-theme="${themeName}"]`);
			if (activeBtn) {
				const root = document.documentElement;
				const accentColor = getComputedStyle(root).getPropertyValue('--accent-primary').trim();
				activeBtn.style.backgroundColor = 'rgba(255, 255, 255, 0.08)';
				activeBtn.style.color = 'white';
				activeBtn.style.fontWeight = '600';
				activeBtn.style.borderLeft = `3px solid ${accentColor}`;
			}
		}
		
		function applyThemeAndUI(themeName) {
			applyTheme(themeName);
			const theme = themes[themeName];
			if (themeNameEl && theme) themeNameEl.textContent = theme.name;
			updateActiveState(themeName);
		}
		
		// Initialize theme
		const savedTheme = localStorage.getItem('theme') || 'purple';
		applyThemeAndUI(savedTheme);
		
		themeButton.addEventListener('click', (e) => {
			e.stopPropagation();
			// Inline variant expands within the menu; popup behaves like dropdown
			themeMenu.classList.toggle('hidden');
		});
		
		// Close menu when clicking outside
		document.addEventListener('click', (e) => {
			// For inline variant inside the burger menu, don't auto-close on outside click
			if (variant === 'inline') return;
			if (!rootEl.contains(e.target)) themeMenu.classList.add('hidden');
		});
		
		options.forEach(btn => {
			btn.addEventListener('click', () => {
				const themeName = btn.getAttribute('data-theme');
				if (!themeName) return;
				applyThemeAndUI(themeName);
				themeMenu.classList.add('hidden');
			});
		});
	}
	
	// Init ALL instances (mobile menu + desktop header) without ID collisions
	document.querySelectorAll('[data-theme-switcher]').forEach(el => initThemeSwitcher(el));
</script>

<style>
	.theme-switcher {
		pointer-events: auto;
		touch-action: manipulation;
	}
	
	.theme-menu {
		animation: fadeIn 0.2s ease-out;
	}

	/* Inline (mobile menu) variant: look like menu items, not a popup */
	.theme-switcher[data-variant="inline"] {
		width: 100%;
	}

	.theme-switcher[data-variant="inline"] .theme-button {
		width: 100%;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	
	/* Show theme name on mobile for inline variant */
	.theme-switcher[data-variant="inline"] .theme-name {
		display: inline !important;
	}
	
	/* Hide theme name on mobile for popup variant (desktop only) */
	@media (max-width: 767px) {
		.theme-switcher[data-variant="popup"] .theme-name {
			display: none;
		}
	}

	.theme-switcher[data-variant="inline"] .theme-menu {
		position: relative;
		top: auto;
		right: auto;
		min-width: 0;
		box-shadow: none;
	}

	.theme-switcher[data-variant="inline"] .theme-option {
		padding: 0.9rem 1.1rem;
	}
	
	.theme-option:hover,
	.theme-option:focus {
		background-color: rgba(255, 255, 255, 0.08);
	}
	
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
